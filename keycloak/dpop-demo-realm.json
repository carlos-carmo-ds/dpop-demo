{
  "realm": "dpop-demo",
  "displayName": "DPoP Demo",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "clients": [
    {
      "clientId": "dpop-web",
      "name": "DPoP Demo - Front Next.js",
      "description": "Client público (SPA) com PKCE e tokens vinculados a DPoP",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": true,
      "redirectUris": ["http://localhost:3000/callback", "http://dpop.localhost:9080/callback"],
      "webOrigins": ["http://localhost:3000", "http://dpop.localhost:9080"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "dpop.bound.access.tokens": "true",
        "post.logout.redirect.uris": "http://localhost:3000/##http://dpop.localhost:9080/"
      },
      "protocolMappers": [
        {
          "name": "audience-dpop-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "dpop-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "alice",
      "enabled": true,
      "email": "alice@example.com",
      "emailVerified": true,
      "firstName": "Alice",
      "lastName": "Demo",
      "credentials": [
        { "type": "password", "value": "alice123", "temporary": false }
      ]
    }
  ]
}
