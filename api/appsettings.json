{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "DpopDemo": "Information"
    }
  },
  "AllowedHosts": "*",

  "Urls": "http://localhost:5080",

  "Keycloak": {
    "Authority": "http://localhost:8080/realms/dpop-demo",
    "Audience": "dpop-api",
    "RequireHttpsMetadata": false
  },

  "Dpop": {
    "PublicBaseUrl": "http://localhost:5080",
    "ProofLifetimeSeconds": 60,
    "ClockSkewSeconds": 5
  },

  "Cors": {
    "AllowedOrigins": [ "http://localhost:3000" ]
  }
}
